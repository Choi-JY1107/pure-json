{
  "name": "pure-json",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "paraglide-js compile --project ./i18n/project.inlang --outdir ./src/lib/paraglide && vite build",
    "preview": "npm run build && wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "gen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "postinstall": "node scripts/patch-wrangler-punycode.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.6",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.15.0",
    "globals": "^17.3.0",
    "punycode": "^2.3.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.0.0",
    "wrangler": "^4.115.0"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.0.0",
    "@vite-pwa/sveltekit": "^1.0.0",
    "js-yaml": "^4.1.0",
    "json-to-ts": "^2.1.0",
    "monaco-editor": "^0.52.0",
    "svelte-meta-tags": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
